# Database — individual vars (used by seed.js and tooling)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fg_inventory
DB_USER=postgres
DB_PASSWORD=changeme

# Database — connection string (used by knex/app; overrides individual vars above if set)
DATABASE_URL=postgresql://postgres:changeme@localhost:5432/fg_inventory

# Auth
JWT_SECRET=change-this-to-a-random-256-bit-secret
JWT_EXPIRES_IN=8h

# Server
PORT=4000
NODE_ENV=production

# Optional: CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173

# Optional: Express trust proxy value for reverse-proxy deployments
TRUST_PROXY=loopback

# Optional: JSON request body limit
JSON_BODY_LIMIT=2mb

# Optional: product lookup / AI classification
OFF_BASE_URL=https://world.openfoodfacts.org
ANTHROPIC_API_KEY=
CLAUDE_API_KEY=
CLASSIFY_MODEL=claude-haiku-4-5-20251001

# Optional: backup retention days
BACKUP_KEEP=30

# Optional: daily invoice folder import
INVOICE_FOLDER=./invoices
INVOICE_IMPORT_USER=admin@fg.local
